manifest {
    name            = 'seqeralabs/nf-raffle'
    description     = 'Enter event raffles at Seqera-sponsored conferences'
    homePage        = 'https://github.com/seqeralabs/nf-raffle'
    nextflowVersion = '!>=26.10.0'
}

plugins {
    id 'nf-schema@3.0.0'
}

validation {
    help {
        command = 'nextflow run seqeralabs/nf-raffle --email <your email> --event <event>'
    }
}

// Maps --outdir to the workflow output{} block. The params{} default in
// main.nf is not visible here because the config is read before the script.
outputDir = params.outdir ?: 'results'

docker {
    enabled    = false
    runOptions = '-u $(id -u):$(id -g)'
}

profiles {
    docker {
        docker.enabled = true
    }

    // Posts to a local mock form (tests/mock_form_server.py) instead of a real
    // event form. Used by CI; never points at a Google Form.
    test {
        params.event_config = "${projectDir}/tests/test_event.json"
        params.email        = 'ci.test@example.com'
        params.first_name   = 'Test'
        params.last_name    = 'Runner'
        params.affiliation  = 'nf-raffle CI'
    }
}
