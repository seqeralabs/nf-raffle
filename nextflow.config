manifest {
    nextflowVersion = '!>=26.04.0'
}

// Maps --outdir to the workflow output{} block. The params{} default in
// main.nf is not visible here because the config is read before the script.
outputDir = params.outdir ?: 'results'

docker {
    enabled    = false
    runOptions = '-u $(id -u):$(id -g)'
}


profiles {
    docker {
        docker.enabled = true
    }
}
