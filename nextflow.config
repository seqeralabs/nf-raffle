// Pipeline parameters are declared with types in the `params {}` block in main.nf.

// Map the pipeline's --outdir parameter onto the workflow output directory
// used by the workflow `output {}` block (replaces the old publishDir).
outputDir = params.outdir

docker {
    enabled = false
    runOptions = '-u $(id -u):$(id -g)'
}


profiles {
    docker {
        docker.enabled = true
    }
}
